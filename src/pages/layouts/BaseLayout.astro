---
// 导入导航栏组件
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// 接收页面标题和当前路径作为属性
const { title, currentPath } = Astro.props;
const siteName = 'QLNU-Sec-Team';
const pageTitle = `${siteName} - ${title}`;
const pageDescription = "齐鲁师范学院网络安全社团(QLNU-Sec-Team)官方网站";
const pageUrl = `https://www.qlnu-sec.cn${currentPath || ''}`; // Replace with your actual site URL
const imageUrl = 'https://www.qlnu-sec.cn/icon.png'; // Replace with your actual image URL
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href="/icon.png">
  <!-- SEO Meta Tags -->
  <meta name="description" content={pageDescription}>
  <meta name="keywords" content="cybersecurity, QLNU, security team, CTF, information security">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDescription}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:type" content="website">
  <style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
    }
  </style>
</head>
<body>
  <Navbar currentPath={currentPath} />
  <div class="content">
    <slot />
    <Footer /> 

  </div>

  <style>
    .content {
        margin-left: calc(50% - 500px + 160px);
        margin-right: 3%;
        max-width: 800px;
        border-left: 1px solid rgba(0, 0, 0, 0.12);
        padding-left: 3%;
        animation: fadeUp 0.4s ease both;
    }

    body {
        background-color: #fff;
        color: #2d2d2d;
        margin: 0;
        overflow-x: hidden;
        min-height: 100vh;
        padding-bottom: 1px; /* 根据 footer 的高度设置适当的填充 */
        font-family: 'Noto Sans SC Variable', -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        -webkit-font-smoothing: antialiased;
        line-height: 1.75;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: none; }
    }

    @media (max-width: 1200px) {
      .content {
        margin-left: 260px;
        margin-right: 10%;
        max-width: 800px;
      }
    }

    @media (max-width: 768px) {
      .content {
        margin-left: 3%;
        margin-right: 3%;
        border-left: none;
        padding-left: 0;
      }

      body {
        padding-bottom: 10px;
    }

  }
  </style>
</body>
</html>
