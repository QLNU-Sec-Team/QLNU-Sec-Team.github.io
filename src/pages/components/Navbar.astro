---
// 导入导航项组件
import NavItem from './NavItem.astro';
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/overpass-mono';
import '@fontsource-variable/noto-sans-sc';
import Footer from './Footer.astro';

// 导航项数据，可以从API或文件中读取
const navItems = [
  { label: '关于 About', href: '/' },
  { label: '成员 Members', href: '/member' },
  { label: '奖项 Awards', href: '/award' },
  { label: '友链 Friends', href: '/friends' },
];
const { currentPath } = Astro.props;
const showName = '齐鲁师范学院网络安全社团';
---

<nav class="navbar">
  <div class="logo-container">
    <a href="https://www.qlnu-sec.cn/">
      <img src="/QLNU.png" alt="Logo" class="logo" />
    </a>
  </div>
  <div class="show-name">
    {showName}
  </div>
  <ul id="menu">
    {navItems.map(item => (
      <NavItem label={item.label} href={item.href} isActive={item.href === currentPath} />
    ))}
  </ul>
  <ViewTransitions /> 
  <button type="button" class="hamburger" data-menu-toggle aria-label="打开菜单" aria-expanded="false" aria-controls="mobileMenu">
    <div class="line"></div>
    <div class="line"></div>
    <div class="line"></div>
  </button>
</nav>

<ul class="nav2 hidetag" id="mobileMenu">
  {navItems.map(item => (
    <NavItem label={item.label} href={item.href} isActive={item.href === currentPath} />
  ))}
</ul>
<style>
.nav2{
  display: none;
}
.hamburger {
  display: none;
  position: absolute;
  cursor: pointer;
  border: 0;
  padding: 0;
  background: none;
  -webkit-tap-highlight-color: transparent;
}

.hamburger .line {
  display: block;
  width: 22px;
  height: 2px;
  border-radius: 3px;
  background-color: #6b6b6b;
}

.navbar {
  font-family: 'Noto Sans SC Variable', sans-serif;
  width: 200px;
  position: fixed;
  top: 50%;
  left: 10%;
  height: auto;
  padding: 20px 0;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.navbar.horizontal {
  width: 140px;
  height: auto;
  position: relative;
  top: 0;
  left: 0;
  transform: none;
  padding: 10px 20px;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}

.navbar ul {

  list-style-type: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  flex-direction: column;
  align-items: center;
  width: 100%;
  border-top: 1px solid #f0f0f0;
  padding-top: 18px;
}

.navbar.horizontal ul {
  flex-direction: row;
  justify-content: space-around;
  width: auto;
  flex-grow: 1;
}

.navbar ul li {
  width: 100%;
  margin: 10px 0; /* 增加间距 */
}

.navbar.horizontal ul li {
  margin: 0 10px;
}

.logo-container {
  display: flex;
  justify-content: center;
  align-items: center;
}

.logo {
  width: 120px;
  height: 120px;
  margin-bottom: 20px;
  border-radius: 12px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.logo:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.14);
}

.show-name {
  text-align: center;
  margin-bottom: 20px;
  font-size: 15px;
  font-weight: 500;
  color: #333;
  letter-spacing: 0.03em;
  line-height: 1.7;
}

.navbar.horizontal .logo {
  margin-bottom: 0;
  margin-right: 20px;
}
@media (max-width: 1400px) {
  .navbar {
    left: 4%;
  }
}
@media (max-width: 768px) {
  .navbar {
    width: 100%;
    position: relative;
    top: 0;
    left: 0;
    transform: none;
    height: 60px;
    padding: 0 12px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    z-index: 10;
  }

  #menu {
    display: none;
  }

  .logo {
    width: 40px;
    height: 40px;
    margin: 0;
    box-shadow: none;
  }
  .logo:hover {
    transform: none;
    box-shadow: none;
  }

  .show-name {
    flex: 1;
    min-width: 0;
    margin: 0 12px;
    display: block;
    text-align: center;
    font-size: 16px;
    font-weight: 500;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    align-items: center;
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    padding: 10px;
    z-index: 20;
  }

  .nav2 {
    border-radius: 10px;
    width: 168px;
    display: flex;
    background-color: #ffffff;
    border: 1px solid #ececec;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    list-style-type: none;
    padding: 6px;
    margin: 0;
    flex-direction: column;
    align-items: center;
    position: absolute;
    top: 70px;
    right: 12px;
    z-index: 999;
  }
  .hidetag {
    display: none;
  }

  body {
    font-family: 'Overpass Mono Variable', monospace;
  }
}


</style>
<script>
  // 移动端菜单逻辑：事件委托绑定一次，DOM 由 ViewTransitions 整体替换后依然有效
  const initKey = '__qlnuMenuToggleBound';
  if (!window[initKey]) {
    window[initKey] = true;

    const setMenu = (open) => {
      const menu = document.getElementById('mobileMenu');
      const toggle = document.querySelector('[data-menu-toggle]');
      if (menu) menu.classList.toggle('hidetag', !open);
      if (toggle) toggle.setAttribute('aria-expanded', String(open));
    };

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-menu-toggle]');
      if (toggle) {
        // 仅在移动端视口（<768px，菜单与汉堡按钮出现的断点）下生效
        if (window.innerWidth >= 768) return;
        const menu = document.getElementById('mobileMenu');
        if (!menu) return;
        setMenu(menu.classList.contains('hidetag'));
        return;
      }
      // 点击移动菜单内的链接后收起菜单
      if (event.target.closest('#mobileMenu a')) {
        setMenu(false);
      }
    });

    // 视口放大到桌面端时强制收起菜单
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) setMenu(false);
    });
  }
</script>
