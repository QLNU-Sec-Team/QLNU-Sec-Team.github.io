---
const contactEmail = 'contact@qlnu-sec.cn';

const weChatImage = '/wx.svg'; // 请确保 wx.svg 的路径正确
const creator = 'shenghuo2';
---
<hr>
<footer class="footer">
  <div class="footer-content">
    <div class="contact-info">
      <div class="wechat-info">
        <div class="wx"></div>
        <div class="wechat-image-container">
          <img src={weChatImage} alt="WeChat QR Code" class="wechat-image" />
        </div>
      </div>
    </div>
  </div>
  <div>
    <div class="copyright">
      
    &copy; <a href="https://github.com/QLNU-Sec-Team">QLNU-Sec-Team</a>
    2025 <br>联系邮箱：<a href={`mailto:${contactEmail}`}>{contactEmail}</a><br> Designed by <a style="color:black;" href=`https://github.com/${creator}`>{creator}</a> using Astro
    <br><a href="https://beian.miit.gov.cn/" target="_blank" style="color:#333;">鲁ICP备2021005646号-2</a>

  </div>
</footer>
<style>
  .footer {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 16px 10px 20px;
    margin: auto;
    text-align: center;
    width: 80%;
    color: #555;
    font-size: 14px;
    line-height: 1.9;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 10px; /* 减小行间距 */
  }

  .contact-info {
    display: flex;
    flex-direction: row;
    align-items: center; /* 垂直居中 */
    gap: 20px;
  }

  .footer a {
    color: #4a4a4a;
    transition: color 0.2s ease;
  }

  .footer a:hover {
    color: #000;
    text-decoration: underline;
  }

  .wechat-info {
    display: flex;
    flex-direction: column;
    align-items: center; /* 垂直居中 */
  }

  .wx::after {
    content: "微信公众号";
    font-size: 13px;
    color: #888;
  }

  .wechat-image-container {
    background-color: white; /* 设置背景颜色为白色 */
    padding: 4px; /* 添加内边距 */
    border-radius: 8px;
    border: 1px solid #ececec;
    transition: box-shadow 0.25s ease;
  }
  .wechat-image-container:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  .wechat-image {
    width: 80px;
    height: 80px;
    display: block; /* 确保图片为块级元素 */
  }
@media (max-width: 768px) {
.footer {
  background-color: #ffffff;
  padding: 20px;
  text-align: center;
  font-size: 13px;
  margin-top: 0;
}
}
</style>
